<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>

    
    <form id="nameForm">
        <label for="fname">First name: </label>
        <input type="text" id="fname" name="fname" required><br><br>

        <label for="lname">Last name: </label>
        <input type="text" id="lname" name="lname" required><br><br>

        <input type="submit" value="Submit">
    </form>

    <script>
            //Finds the `<form>` element with the `id="nameForm"` and Listens for submition
        document.getElementById('nameForm').addEventListener('submit', async function (e) {
        e.preventDefault();

        //Stores submitted names in objects
        const data = {
            fname: document.getElementById('fname').value,
            lname: document.getElementById('lname').value,
        };

            //Waits for server to respond and then sends object data in JSON format 
        const res = await fetch('/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
        });
            //Waits for respons to be converted to JSON then alerts with message from server
        const result = await res.json();
        alert(result.message);
        });
  </script>
</body>
</html>